            " "
            <option value="wholesale">"Wholesale cashier"</option>
            <option value="retail">"Aeroton Retail manager"</option>
            <option value="citydeep">"City Deep Retail manager"</option>
            <option value="manager">"Manager"</option>
            <option value="admin">"Administrator"</option>
