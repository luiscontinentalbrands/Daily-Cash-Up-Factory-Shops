exports[`report for a date range, hide banked, tick and untick 1`] = `
## before loading
<main id="main">
  <section class="sheet">
    " "
    <div class="sheet-head">
      <div>
        <div class="eyebrow">"CashGuard · Aeroton Retail and City Deep Retail"</div>
        <h2>"Money not banked"</h2>
      </div>
    </div>
    " "
    <div class="sheet-body">
      " "
      <div class="msg">
        "Cash counted from the CashGuard and kept back, not deposited in Nedbank, and Aeroton Retail petty cash, for each day in the period. When the money is banked, the administrator ticks "
        <b>"Banked"</b>
        " and it is taken off the total."
      </div>
      " "
      <form id="nbform" class="fields" style="grid-template-columns:minmax(0,1fr) minmax(0,1fr) auto;align-items:end" novalidate>
        " "
        <div class="field">
          <label for="nbfrom">"From"</label>
          <input type="date" id="nbfrom" value="2026-10-01" max="2026-10-28">
        </div>
        " "
        <div class="field">
          <label for="nbto">"To"</label>
          <input type="date" id="nbto" value="2026-10-28" max="2026-10-28">
        </div>
        " "
        <button class="btn primary" type="submit" id="nbgo">"Show report"</button>
        " "
      </form>
      " "
      <div class="empty-state">"Choose the dates and tap Show report."</div>
      " "
    </div>
  </section>
</main>
`;

