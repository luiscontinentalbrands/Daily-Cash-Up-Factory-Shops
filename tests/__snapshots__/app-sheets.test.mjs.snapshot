              </td>
              " "
              <td class="inp">
                <input id="wholesale-cash-deposited" data-m="cash" data-f="deposited" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value aria-label="Cash deposited">
              </td>
              " "
              <td class="num var-zero" id="v-cash">"R 0,00"</td>
