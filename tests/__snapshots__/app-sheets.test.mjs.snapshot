exports[`older stored data is tidied on load (Retail EFT into card, no Shop2Shop, no Wholesale retained) 3`] = `
## retail totals
<tfoot>
  <tr>
    <td>
      "Total"
      <div class="msg" style="font-size:.72rem;font-weight:400;font-family:var(--body)">"Credit card CBM not included"</div>
    </td>
    <td class="num" id="t-report">"R 160,50"</td>
    <td class="num" id="t-dep">"R 150,50"</td>
    <td class="num var-neg" id="t-var">"−R 10,00"</td>
  </tr>
  " "
  <tr class="cgnote">
    <td colspan="4" id="t-cg">
      "Includes CashGuard counted & retained, not banked: "
      <b>"R 5,00"</b>
      ". Banked total: R 145,50."
    </td>
  </tr>
</tfoot>
`;

exports[`save refused: message on the sheet and an alert 1`] = `
## sheet note
NOT SAVED. The database refused to save it (permission-denied). The Firebase rules may be out of date.
`;

exports[`save refused: message on the sheet and an alert 2`] = `
## alert
<div id="savealert" role="alert" style="position:fixed;left:16px;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));z-index:40;background:var(--bad);color:#fff;padding:12px 16px;border-radius:12px;font-weight:600;box-shadow:0 10px 30px rgba(0,0,0,.25)">"Your last change was NOT saved. The database refused to save it (permission-denied). The Firebase rules may be out of date."</div>
`;

exports[`save refused: message on the sheet and an alert 3`] = `
## offline note
NOT SAVED. Could not reach the database (unavailable). Check the connection.
`;

exports[`sheets with figures, draft and signed, seen by different roles 1`] = `
## u-whole on wholesale, signed: none
<main id="main">
  <div class="banner wait" style="font-weight:500">"Due by 7 pm · 1h 0m left. Wholesale, Aeroton Retail, City Deep Retail and the manager must all sign."</div>
  " "
  <div class="deptband wholesale" role="heading" aria-level="2">
    <div>
      <div class="big">"Wholesale cash up"</div>
      <div class="small">"Wednesday, 28 October 2026"</div>
    </div>
    <div class="small">
      "You are filling in the "
      <b>"Wholesale"</b>
      " sheet"
    </div>
  </div>
  " "
  <section class="sheet wholesale">
    " "
    <div class="sheet-head">
      <div>
        <div class="eyebrow">"Wholesale department"</div>
        <h2>"Wednesday, 28 October 2026"</h2>
      </div>
      <span class="chip draft">"In progress"</span>
    </div>
    " "
    <div class="sheet-body">
      " "
      <div class="fields">
        " "
        <div class="field">
          <label>"Date"</label>
          <div class="static">"Wed, 28 Oct 2026"</div>
        </div>
        " "
        <div class="field">
          <label>"Person cashing up"</label>
          <div class="static">"Wanda Wholesale"</div>
        </div>
        " "
        <div class="field">
          <label>"Department"</label>
          <div class="static">"Wholesale"</div>
        </div>
        " "
      </div>
      " "
      <div class="scan">
        " "
        <div style="min-width:0">
          <div class="eyebrow">"Fill from photo"</div>
          <div class="msg">"Take a photo of the last page of the cash up report, or attach a saved photo or PDF. The report figures are filled in for you to check, and a copy is kept with this cash up."</div>
        </div>
        " "
        <div class="actions">
          " "
          <label class="btn primary" for="wholesale-photo" style="display:inline-flex;align-items:center;gap:8px">"Scan report photo"</label>
          " "
          <label class="btn" for="wholesale-photo2" style="display:inline-flex;align-items:center;gap:8px">"Add another photo"</label>
          " "
          <label class="btn" for="wholesale-file" style="display:inline-flex;align-items:center;gap:8px">"Attach file"</label>
          " "
        </div>
        " "
        <input type="file" id="wholesale-photo" accept="image/*" capture="environment" hidden>
        " "
        <input type="file" id="wholesale-photo2" accept="image/*" capture="environment" hidden>
        " "
        <input type="file" id="wholesale-file" accept="image/*,application/pdf,.pdf" multiple hidden>
        " "
        <div class="msg" id="scan-msg" style="flex-basis:100%"></div>
        " "
      </div>
      " "
      <div class="field">
        <label>"Report photos"</label>
        <div data-photos="wholesale">
          <div class="msg">"No photo yet."</div>
        </div>
      </div>
      " "
      <div class="tbl-wrap">
        <table class="lines">
          " "
          <thead>
            <tr>
              <th>"Payment type"</th>
              <th>
                "Per report"
                <small>"Till / Z-report"</small>
              </th>
              <th>
                "Deposited"
                <small>"Actual counted"</small>
              </th>
              <th>
                "Variance"
                <small>"Deposited − report"</small>
              </th>
            </tr>
          </thead>
          " "
          <tbody>
            <tr>
              <td>"Cash"</td>
              " "
              <td class="inp">
                <input id="wholesale-cash-report" data-m="cash" data-f="report" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="1500.00" aria-label="Cash per report">
              </td>
              " "
              <td class="inp">
                <input id="wholesale-cash-deposited" data-m="cash" data-f="deposited" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="1450.00" aria-label="Cash deposited">
              </td>
              " "
              <td class="num var-neg" id="v-cash">"−R 50,00"</td>
            </tr>
            <tr>
              <td>"CashGuard"</td>
              " "
              <td class="inp">
                <input id="wholesale-cashguard-report" data-m="cashguard" data-f="report" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="2000.00" aria-label="CashGuard per report">
              </td>
              " "
              <td class="inp">
                <input id="wholesale-cashguard-deposited" data-m="cashguard" data-f="deposited" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="2000.00" aria-label="CashGuard deposited">
              </td>
              " "
              <td class="num var-zero" id="v-cashguard">"R 0,00"</td>
            </tr>
            <tr>
              <td>"Credit card"</td>
              " "
              <td class="inp">
                <input id="wholesale-card-report" data-m="card" data-f="report" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="3200.50" aria-label="Credit card per report">
              </td>
              " "
              <td class="inp">
                <input id="wholesale-card-deposited" data-m="card" data-f="deposited" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="3200.50" aria-label="Credit card deposited">
              </td>
              " "
              <td class="num var-zero" id="v-card">"R 0,00"</td>
            </tr>
            <tr>
              <td>
                "Credit card CBM"
                <div class="msg" style="font-size:.72rem;font-weight:400">"Not included in the total"</div>
              </td>
              " "
              <td class="inp">
                <input id="wholesale-cardcbm-report" data-m="cardcbm" data-f="report" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="410.00" aria-label="Credit card CBM per report">
              </td>
              " "
              <td class="inp">
                <input id="wholesale-cardcbm-deposited" data-m="cardcbm" data-f="deposited" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="410.00" aria-label="Credit card CBM deposited">
              </td>
              " "
              <td class="num var-zero" id="v-cardcbm">"R 0,00"</td>
            </tr>
            <tr>
              <td>"PayFast card"</td>
              " "
              <td class="inp">
                <input id="wholesale-payfast-report" data-m="payfast" data-f="report" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="99.99" aria-label="PayFast card per report">
              </td>
              " "
              <td class="inp">
                <input id="wholesale-payfast-deposited" data-m="payfast" data-f="deposited" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="99.99" aria-label="PayFast card deposited">
              </td>
              " "
              <td class="num var-zero" id="v-payfast">"R 0,00"</td>
            </tr>
            <tr>
              <td>"EFT"</td>
              " "
              <td class="inp">
                <input id="wholesale-eft-report" data-m="eft" data-f="report" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="800.00" aria-label="EFT per report">
              </td>
              " "
              <td class="inp">
                <input id="wholesale-eft-deposited" data-m="eft" data-f="deposited" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="800.00" aria-label="EFT deposited">
              </td>
              " "
              <td class="num var-zero" id="v-eft">"R 0,00"</td>
            </tr>
            <tr>
              <td>"Shop2Shop"</td>
              " "
              <td class="inp">
                <input id="wholesale-shop2shop-report" data-m="shop2shop" data-f="report" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="120.00" aria-label="Shop2Shop per report">
              </td>
              " "
              <td class="inp">
                <input id="wholesale-shop2shop-deposited" data-m="shop2shop" data-f="deposited" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="120.00" aria-label="Shop2Shop deposited">
              </td>
              " "
              <td class="num var-zero" id="v-shop2shop">"R 0,00"</td>
            </tr>
            <tr>
              <td>"SnapScan"</td>
              " "
              <td class="inp">
                <input id="wholesale-snapscan-report" data-m="snapscan" data-f="report" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="45.00" aria-label="SnapScan per report">
              </td>
              " "
              <td class="inp">
                <input id="wholesale-snapscan-deposited" data-m="snapscan" data-f="deposited" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="45.00" aria-label="SnapScan deposited">
              </td>
              " "
              <td class="num var-zero" id="v-snapscan">"R 0,00"</td>
            </tr>
          </tbody>
          " "
          <tfoot>
            <tr>
              <td>
                "Total"
                <div class="msg" style="font-size:.72rem;font-weight:400;font-family:var(--body)">"Credit card CBM not included"</div>
              </td>
              <td class="num" id="t-report">"R 7 765,49"</td>
              <td class="num" id="t-dep">"R 7 715,49"</td>
              <td class="num var-neg" id="t-var">"−R 50,00"</td>
            </tr>
            " "
          </tfoot>
          " "
        </table>
      </div>
      " "
      <div class="dmg">
        " "
        <div class="field">
          <label for="wholesale-damaged">"Damaged bank notes & coins (R)"</label>
          <input id="wholesale-damaged" class="num" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="100.00" style="text-align:right">
        </div>
        " "
        <div class="field">
          <label for="wholesale-damagedNotes">"Damaged details"</label>
          <input id="wholesale-damagedNotes" value="1 x R100 torn" placeholder="e.g. 1 × R100 torn, 3 × R5 coins bent" autocomplete="off" maxlength="300">
        </div>
        " "
      </div>
      " "
      <div class="field">
        <label for="wholesale-notes">"Notes (explain any variance)"</label>
        <textarea id="wholesale-notes" maxlength="1000" placeholder="e.g. R50 short on cash, float counted twice">"R50 short, float counted twice"</textarea>
      </div>
      " "
      <div class="saved" id="saved-wholesale">"Last saved 28 Oct, 10:00"</div>
      " "
    </div>
    " "
  </section>
  " "
  <section class="sheet declsec">
    " "
    <div class="declhead">
      <div class="declicon" aria-hidden="true">"✍"</div>
      <div>
        <h2>"Store manager sign-off"</h2>
        <div class="small">"Card transactions · Wed, 28 Oct 2026 · must be complete before Wholesale can sign"</div>
      </div>
      " "
      <span class="chip draft">"Not complete"</span>
    </div>
    " "
    <div class="sheet-body">
      <div class="decl" id="decl-wholesale">
        <blockquote class="dstate">"“I have checked every individual card transaction on this report. Every transaction has a card slip with a matching till slip stapled to it, and every split payment has my authorisation.”"</blockquote>
        " "
        <div class="msg"></div>
        " "
        <div class="dtills">
          <div class="dtill">
            " "
            <div class="dtill-head">
              <b>"Till 1"</b>
            </div>
            " "
            <div class="dgrid">
              <div class="field">
                <label for="dt-wholesale-0-tx">"Transactions"</label>
                <input id="dt-wholesale-0-tx" data-till="0" data-f="tx" inputmode="numeric" class="num" style="text-align:right" autocomplete="off" value>
              </div>
              <div class="field">
                <label for="dt-wholesale-0-slips">"Slips counted"</label>
                <input id="dt-wholesale-0-slips" data-till="0" data-f="slips" inputmode="numeric" class="num" style="text-align:right" autocomplete="off" value>
              </div>
            </div>
            " "
            <div class="ddiff var-neg" id="dd-wholesale-0"></div>
            " "
            <div class="field">
              <label for="dt-wholesale-0-reason">"Reason for any difference"</label>
              <input id="dt-wholesale-0-reason" data-till="0" data-f="reason" maxlength="300" autocomplete="off" value>
            </div>
            " "
          </div>
        </div>
        " "
        <div class="eyebrow" id="dcount-wholesale" style="margin-top:6px">"Manager's checklist before signing · 0 of 6 ticked"</div>
        " "
        <label class="declitem">
          <input type="checkbox" data-decl="slipcount">
          <span>"Number of slips equals number of transactions on the machine total"</span>
        </label>
        <label class="declitem">
          <input type="checkbox" data-decl="stapled">
          <span>"Every card slip has its till slip stapled to it"</span>
        </label>
        <label class="declitem">
          <input type="checkbox" data-decl="amounts">
          <span>"Amount on each card slip matches its till slip"</span>
        </label>
        <label class="declitem">
          <input type="checkbox" data-decl="splits">
          <span>"Every split payment is initialled by me"</span>
        </label>
        <label class="declitem">
          <input type="checkbox" data-decl="totals">
          <span>"Machine total equals Palladium card total, or the difference is explained"</span>
        </label>
        <label class="declitem">
          <input type="checkbox" data-decl="filed">
          <span>"Slips and signed total are punched and filed together for the day"</span>
        </label>
      </div>
    </div>
  </section>
  " "
  <section class="sheet">
    " "
    <div class="sheet-head">
      <div>
        <div class="eyebrow">"Sign-off"</div>
        <h2>"Wholesale signature"</h2>
      </div>
    </div>
    " "
    <div class="sheet-body">
      <div class="sign">
        " "
        <div class="pad">
          <canvas id="pad" data-dept="wholesale" width="900" height="300" aria-label="Signature pad"></canvas>
          <div class="base"></div>
          <div class="hint">"Sign above the line with finger or mouse"</div>
        </div>
        " "
        <div style="display:flex;flex-direction:column;gap:10px">
          " "
          <div class="msg">"By signing, I confirm the amounts deposited for Wholesale on Wed, 28 Oct 2026 are correct."</div>
          " "
          <div>
            <div class="eyebrow">"Signing as"</div>
            <div class="signer-static">"Wanda Wholesale"</div>
          </div>
          " "
          <div class="actions">
            <button class="btn" id="clear" type="button">"Clear"</button>
            <button class="btn primary" id="signbtn" type="button">"Sign & submit"</button>
          </div>
          " "
          <div class="msg" id="sign-msg"></div>
          " "
        </div>
      </div>
    </div>
    " "
  </section>
</main>
`;

