              <input id="dt-retail-3-reason" data-till="3" data-f="reason" maxlength="300" autocomplete="off" value>
            </div>
            " "
          </div>
          <div class="dtill">
            " "
            <div class="dtill-head">
              <b>"Till 5"</b>
            </div>
            " "
            <div class="dgrid">
              <div class="field">
                <label for="dt-retail-4-tx">"Transactions"</label>
                <input id="dt-retail-4-tx" data-till="4" data-f="tx" inputmode="numeric" class="num" style="text-align:right" autocomplete="off" value>
              </div>
              <div class="field">
                <label for="dt-retail-4-slips">"Slips counted"</label>
                <input id="dt-retail-4-slips" data-till="4" data-f="slips" inputmode="numeric" class="num" style="text-align:right" autocomplete="off" value>
              </div>
            </div>
            " "
            <div class="ddiff var-neg" id="dd-retail-4"></div>
            " "
            <div class="field">
              <label for="dt-retail-4-reason">"Reason for any difference"</label>
              <input id="dt-retail-4-reason" data-till="4" data-f="reason" maxlength="300" autocomplete="off" value>
            </div>
            " "
          </div>
          <div class="dtill">
            " "
            <div class="dtill-head">
              <b>"Till 6"</b>
            </div>
            " "
            <div class="dgrid">
              <div class="field">
                <label for="dt-retail-5-tx">"Transactions"</label>
                <input id="dt-retail-5-tx" data-till="5" data-f="tx" inputmode="numeric" class="num" style="text-align:right" autocomplete="off" value>
              </div>
              <div class="field">
                <label for="dt-retail-5-slips">"Slips counted"</label>
                <input id="dt-retail-5-slips" data-till="5" data-f="slips" inputmode="numeric" class="num" style="text-align:right" autocomplete="off" value>
              </div>
            </div>
            " "
            <div class="ddiff var-neg" id="dd-retail-5"></div>
            " "
            <div class="field">
              <label for="dt-retail-5-reason">"Reason for any difference"</label>
              <input id="dt-retail-5-reason" data-till="5" data-f="reason" maxlength="300" autocomplete="off" value>
            </div>
            " "
          </div>
        </div>
        " "
        <div class="eyebrow" id="dcount-retail" style="margin-top:6px">"Manager's checklist before signing · 0 of 6 ticked"</div>
        " "
        <label class="declitem">
          <input type="checkbox" data-decl="slipcount">
          <span>"Number of slips equals number of transactions on the machine total"</span>
        </label>
        <label class="declitem">
          <input type="checkbox" data-decl="stapled">
          <span>"Every card slip has its till slip stapled to it"</span>
        </label>
        <label class="declitem">
          <input type="checkbox" data-decl="amounts">
          <span>"Amount on each card slip matches its till slip"</span>
        </label>
        <label class="declitem">
          <input type="checkbox" data-decl="splits">
          <span>"Every split payment is initialled by me"</span>
        </label>
        <label class="declitem">
          <input type="checkbox" data-decl="totals">
          <span>"Machine total equals Palladium card total, or the difference is explained"</span>
        </label>
        <label class="declitem">
          <input type="checkbox" data-decl="filed">
          <span>"Slips and signed total are punched and filed together for the day"</span>
        </label>
      </div>
    </div>
  </section>
  " "
  <section class="sheet">
    " "
    <div class="sheet-head">
      <div>
        <div class="eyebrow">"Sign-off"</div>
        <h2>"Aeroton Retail signature"</h2>
      </div>
    </div>
    " "
    <div class="sheet-body">
      <div class="sign">
        " "
        <div class="pad">
          <canvas id="pad" data-dept="retail" width="900" height="300" aria-label="Signature pad"></canvas>
          <div class="base"></div>
          <div class="hint">"Sign above the line with finger or mouse"</div>
        </div>
        " "
        <div style="display:flex;flex-direction:column;gap:10px">
          " "
          <div class="msg">"By signing, I confirm the amounts deposited for Aeroton Retail on Wed, 28 Oct 2026 are correct."</div>
          " "
          <div>
            <div class="eyebrow">"Signing as"</div>
            <div class="signer-static">"Rita Retail"</div>
          </div>
          " "
          <div class="actions">
            <button class="btn" id="clear" type="button">"Clear"</button>
            <button class="btn primary" id="signbtn" type="button">"Sign & submit"</button>
          </div>
          " "
          <div class="msg" id="sign-msg"></div>
          " "
        </div>
      </div>
    </div>
    " "
  </section>
  <section class="sheet" id="ho-sec">
    <div class="sheet-head">
      <div>
        <div class="eyebrow">"Cash not banked · handover"</div>
        <h2>"Cash handed to Candido"</h2>
      </div>
      <span class="chip">"R 0,00 not banked today"</span>
    </div>
    " "
    <div class="sheet-body">
      " "
      <div class="msg">"When Aeroton Retail hands over the cash that was not banked (CashGuard retained and petty cash), Candido checks the amount and signs here to confirm he received it."</div>
      " "
      <div id="ho-list">
        <div class="msg">"No cash handed over yet for this day."</div>
      </div>
      " "
      <div class="sign" style="margin-top:12px">
        " "
        <div class="pad">
          <canvas id="hpad" width="900" height="300" aria-label="Signature pad for the person receiving the cash"></canvas>
          <div class="base"></div>
          <div class="hint">"Candido signs above the line"</div>
        </div>
        " "
        <div style="display:flex;flex-direction:column;gap:10px">
          " "
          <div class="field">
            <label for="ho-amt">"Amount handed over (R)"</label>
            <input id="ho-amt" class="num" inputmode="decimal" autocomplete="off" value placeholder="0.00" style="text-align:right">
          </div>
          " "
          <div class="field">
            <label for="ho-to">"Received by"</label>
            <input id="ho-to" value="Candido" maxlength="60" autocomplete="off">
          </div>
          " "
          <div class="field">
            <label for="ho-note">"Note (optional)"</label>
            <input id="ho-note" maxlength="200" autocomplete="off" placeholder="e.g. envelope sealed, counted together">
          </div>
          " "
          <div>
            <div class="eyebrow">"Handed over by"</div>
            <div class="signer-static">"Rita Retail"</div>
          </div>
          " "
          <div class="actions">
            <button class="btn" id="ho-clear" type="button">"Clear"</button>
            <button class="btn primary" id="ho-sign" type="button">"Sign for the cash"</button>
          </div>
          " "
          <div class="msg" id="ho-msg"></div>
          " "
        </div>
      </div>
      " "
    </div>
  </section>
</main>
`;

exports[`empty sheets, as their own cashier/manager 3`] = `
## citydeep
<main id="main">
  <div class="banner wait" style="font-weight:500">"Due by 7 pm · 9h 0m left. Wholesale, Aeroton Retail, City Deep Retail and the manager must all sign."</div>
  " "
  <div class="deptband citydeep" role="heading" aria-level="2">
    <div>
      <div class="big">"City Deep Retail cash up"</div>
      <div class="small">"Wednesday, 28 October 2026"</div>
    </div>
    <div class="small">
      "You are filling in the "
      <b>"City Deep Retail"</b>
      " sheet"
    </div>
  </div>
  " "
  <section class="sheet citydeep">
    " "
    <div class="sheet-head">
      <div>
        <div class="eyebrow">"City Deep Retail department"</div>
        <h2>"Wednesday, 28 October 2026"</h2>
      </div>
      <span class="chip">"Not started"</span>
    </div>
    " "
    <div class="sheet-body">
      " "
      <div class="fields">
        " "
        <div class="field">
          <label>"Date"</label>
          <div class="static">"Wed, 28 Oct 2026"</div>
        </div>
        " "
        <div class="field">
          <label>"Person cashing up"</label>
          <div class="static">"Cindy Deep"</div>
        </div>
        " "
        <div class="field">
          <label>"Department"</label>
          <div class="static">"City Deep Retail"</div>
        </div>
        " "
      </div>
      " "
      <div class="scan">
        " "
        <div style="min-width:0">
          <div class="eyebrow">"Fill from photo"</div>
          <div class="msg">"Take a photo of the last page of the cash up report, or attach a saved photo or PDF. The report figures are filled in for you to check, and a copy is kept with this cash up."</div>
        </div>
        " "
        <div class="actions">
          " "
          <label class="btn primary" for="citydeep-photo" style="display:inline-flex;align-items:center;gap:8px">"Scan report photo"</label>
          " "
          <label class="btn" for="citydeep-photo2" style="display:inline-flex;align-items:center;gap:8px">"Add another photo"</label>
          " "
          <label class="btn" for="citydeep-file" style="display:inline-flex;align-items:center;gap:8px">"Attach file"</label>
          " "
        </div>
        " "
        <input type="file" id="citydeep-photo" accept="image/*" capture="environment" hidden>
        " "
        <input type="file" id="citydeep-photo2" accept="image/*" capture="environment" hidden>
        " "
        <input type="file" id="citydeep-file" accept="image/*,application/pdf,.pdf" multiple hidden>
        " "
        <div class="msg" id="scan-msg" style="flex-basis:100%"></div>
        " "
      </div>
      " "
      <div class="field">
        <label>"Report photos"</label>
        <div data-photos="citydeep">
          <div class="msg">"No photo yet."</div>
        </div>
      </div>
      " "
      <div class="tbl-wrap">
        <table class="lines">
          " "
          <thead>
            <tr>
              <th>"Payment type"</th>
              <th>
                "Per report"
                <small>"Till / Z-report"</small>
              </th>
              <th>
                "Deposited"
                <small>"Actual counted"</small>
              </th>
              <th>
                "Variance"
                <small>"Deposited − report"</small>
              </th>
            </tr>
          </thead>
          " "
          <tbody>
            <tr>
              <td>"Coins"</td>
              " "
              <td class="inp">
                <input id="citydeep-cash-report" data-m="cash" data-f="report" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value aria-label="Coins per report">
              </td>
              " "
              <td class="inp">
                <input id="citydeep-cash-deposited" data-m="cash" data-f="deposited" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value aria-label="Coins deposited">
              </td>
              " "
              <td class="num var-zero" id="v-cash">"R 0,00"</td>
            </tr>
            <tr class="cg">
              <td>"CashGuard"</td>
              " "
              <td class="inp">
                <input id="citydeep-cashguard-report" data-m="cashguard" data-f="report" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value aria-label="CashGuard per report">
              </td>
              " "
              <td class="inp">
                <label class="sub" for="citydeep-cashguard-deposited">"Deposited in Nedbank"</label>
                <input id="citydeep-cashguard-deposited" data-m="cashguard" data-f="deposited" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value aria-label="CashGuard deposited in Nedbank">
                " "
                <label class="sub" for="citydeep-cashguard-retained">"Counted & retained, not banked"</label>
                <input id="citydeep-cashguard-retained" data-m="cashguard" data-f="retained" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value aria-label="CashGuard counted and retained, not banked">
              </td>
              " "
              <td class="num var-zero" id="v-cashguard">"R 0,00"</td>
            </tr>
            <tr>
              <td>"Credit card"</td>
              " "
              <td class="inp">
                <input id="citydeep-card-report" data-m="card" data-f="report" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value aria-label="Credit card per report">
              </td>
              " "
              <td class="inp">
                <input id="citydeep-card-deposited" data-m="card" data-f="deposited" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value aria-label="Credit card deposited">
              </td>
              " "
              <td class="num var-zero" id="v-card">"R 0,00"</td>
            </tr>
            <tr>
              <td>"SnapScan"</td>
              " "
              <td class="inp">
                <input id="citydeep-snapscan-report" data-m="snapscan" data-f="report" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value aria-label="SnapScan per report">
              </td>
              " "
              <td class="inp">
                <input id="citydeep-snapscan-deposited" data-m="snapscan" data-f="deposited" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value aria-label="SnapScan deposited">
              </td>
              " "
              <td class="num var-zero" id="v-snapscan">"R 0,00"</td>
            </tr>
          </tbody>
          " "
          <tfoot>
            <tr>
              <td>"Total"</td>
              <td class="num" id="t-report">"R 0,00"</td>
              <td class="num" id="t-dep">"R 0,00"</td>
              <td class="num var-zero" id="t-var">"R 0,00"</td>
            </tr>
            " "
            <tr class="cgnote">
              <td colspan="4" id="t-cg">"Nothing kept back: everything counted was banked."</td>
            </tr>
          </tfoot>
          " "
        </table>
      </div>
      " "
      <div class="dmg">
        " "
        <div class="field">
          <label for="citydeep-damaged">"Damaged bank notes & coins (R)"</label>
          <input id="citydeep-damaged" class="num" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value style="text-align:right">
        </div>
        " "
        <div class="field">
          <label for="citydeep-damagedNotes">"Damaged details"</label>
          <input id="citydeep-damagedNotes" value placeholder="e.g. 1 × R100 torn, 3 × R5 coins bent" autocomplete="off" maxlength="300">
        </div>
        " "
      </div>
      " "
      <div class="field">
        <label for="citydeep-notes">"Notes (explain any variance)"</label>
        <textarea id="citydeep-notes" maxlength="1000" placeholder="e.g. R50 short on cash, float counted twice"></textarea>
      </div>
      " "
      <div class="saved" id="saved-citydeep">"Saves automatically as you type"</div>
      " "
    </div>
    " "
  </section>
  " "
  <section class="sheet declsec">
    " "
    <div class="declhead">
      <div class="declicon" aria-hidden="true">"✍"</div>
      <div>
        <h2>"Store manager sign-off"</h2>
