              </div>
            </div>
            " "
            <div class="ddiff var-neg" id="dd-retail-0"></div>
            " "
            <div class="field">
              <label for="dt-retail-0-reason">"Reason for any difference"</label>
              <input id="dt-retail-0-reason" data-till="0" data-f="reason" maxlength="300" autocomplete="off" value>
            </div>
            " "
          </div>
          <div class="dtill">
            " "
            <div class="dtill-head">
              <b>"Till 2"</b>
            </div>
            " "
            <div class="dgrid">
              <div class="field">
                <label for="dt-retail-1-tx">"Transactions"</label>
                <input id="dt-retail-1-tx" data-till="1" data-f="tx" inputmode="numeric" class="num" style="text-align:right" autocomplete="off" value>
              </div>
              <div class="field">
                <label for="dt-retail-1-slips">"Slips counted"</label>
                <input id="dt-retail-1-slips" data-till="1" data-f="slips" inputmode="numeric" class="num" style="text-align:right" autocomplete="off" value>
