              <input id="dt-citydeep-0-reason" data-till="0" data-f="reason" maxlength="300" autocomplete="off" value>
            </div>
            " "
          </div>
          <div class="dtill">
            " "
            <div class="dtill-head">
              <b>"Till 2"</b>
            </div>
            " "
            <div class="dgrid">
              <div class="field">
                <label for="dt-citydeep-1-tx">"Transactions"</label>
                <input id="dt-citydeep-1-tx" data-till="1" data-f="tx" inputmode="numeric" class="num" style="text-align:right" autocomplete="off" value>
              </div>
              <div class="field">
                <label for="dt-citydeep-1-slips">"Slips counted"</label>
                <input id="dt-citydeep-1-slips" data-till="1" data-f="slips" inputmode="numeric" class="num" style="text-align:right" autocomplete="off" value>
              </div>
            </div>
            " "
            <div class="ddiff var-neg" id="dd-citydeep-1"></div>
            " "
            <div class="field">
              <label for="dt-citydeep-1-reason">"Reason for any difference"</label>
              <input id="dt-citydeep-1-reason" data-till="1" data-f="reason" maxlength="300" autocomplete="off" value>
            </div>
            " "
          </div>
        </div>
        " "
        <div class="eyebrow" id="dcount-citydeep" style="margin-top:6px">"Manager's checklist before signing · 0 of 6 ticked"</div>
        " "
        <label class="declitem">
          <input type="checkbox" data-decl="slipcount">
          <span>"Number of slips equals number of transactions on the machine total"</span>
        </label>
        <label class="declitem">
          <input type="checkbox" data-decl="stapled">
          <span>"Every card slip has its till slip stapled to it"</span>
        </label>
        <label class="declitem">
          <input type="checkbox" data-decl="amounts">
          <span>"Amount on each card slip matches its till slip"</span>
        </label>
        <label class="declitem">
          <input type="checkbox" data-decl="splits">
          <span>"Every split payment is initialled by me"</span>
        </label>
        <label class="declitem">
          <input type="checkbox" data-decl="totals">
          <span>"Machine total equals Palladium card total, or the difference is explained"</span>
        </label>
        <label class="declitem">
          <input type="checkbox" data-decl="filed">
          <span>"Slips and signed total are punched and filed together for the day"</span>
        </label>
      </div>
    </div>
  </section>
  " "
  <section class="sheet">
    " "
    <div class="sheet-head">
      <div>
        <div class="eyebrow">"Sign-off"</div>
        <h2>"City Deep Retail signature"</h2>
      </div>
    </div>
    " "
    <div class="sheet-body">
      <div class="sign">
        " "
        <div class="pad">
          <canvas id="pad" data-dept="citydeep" width="900" height="300" aria-label="Signature pad"></canvas>
          <div class="base"></div>
          <div class="hint">"Sign above the line with finger or mouse"</div>
        </div>
        " "
        <div style="display:flex;flex-direction:column;gap:10px">
          " "
          <div class="msg">"By signing, I confirm the amounts deposited for City Deep Retail on Wed, 28 Oct 2026 are correct."</div>
          " "
          <div>
            <div class="eyebrow">"Signing as"</div>
            <div class="signer-static">"Cindy Deep"</div>
          </div>
          " "
          <div class="actions">
            <button class="btn" id="clear" type="button">"Clear"</button>
            <button class="btn primary" id="signbtn" type="button">"Sign & submit"</button>
          </div>
          " "
          <div class="msg" id="sign-msg"></div>
          " "
        </div>
      </div>
    </div>
    " "
  </section>
</main>
`;

