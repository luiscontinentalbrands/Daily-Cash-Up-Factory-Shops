              </div>
              <div class="field">
                <label for="dt-citydeep-0-slips">"Slips counted"</label>
                <input id="dt-citydeep-0-slips" data-till="0" data-f="slips" inputmode="numeric" class="num" style="text-align:right" autocomplete="off" value disabled>
              </div>
            </div>
            " "
            <div class="ddiff var-neg" id="dd-citydeep-0"></div>
            " "
            <div class="field">
              <label for="dt-citydeep-0-reason">"Reason for any difference"</label>
              <input id="dt-citydeep-0-reason" data-till="0" data-f="reason" maxlength="300" autocomplete="off" value disabled>
            </div>
            " "
          </div>
          <div class="dtill">
            " "
            <div class="dtill-head">
              <b>"Till 2"</b>
            </div>
            " "
            <div class="dgrid">
              <div class="field">
                <label for="dt-citydeep-1-tx">"Transactions"</label>
                <input id="dt-citydeep-1-tx" data-till="1" data-f="tx" inputmode="numeric" class="num" style="text-align:right" autocomplete="off" value disabled>
              </div>
              <div class="field">
                <label for="dt-citydeep-1-slips">"Slips counted"</label>
                <input id="dt-citydeep-1-slips" data-till="1" data-f="slips" inputmode="numeric" class="num" style="text-align:right" autocomplete="off" value disabled>
              </div>
            </div>
            " "
            <div class="ddiff var-neg" id="dd-citydeep-1"></div>
            " "
            <div class="field">
              <label for="dt-citydeep-1-reason">"Reason for any difference"</label>
              <input id="dt-citydeep-1-reason" data-till="1" data-f="reason" maxlength="300" autocomplete="off" value disabled>
            </div>
            " "
          </div>
        </div>
        " "
        <div class="eyebrow" id="dcount-citydeep" style="margin-top:6px">"Manager's checklist before signing · 0 of 6 ticked"</div>
        " "
        <label class="declitem">
          <input type="checkbox" data-decl="slipcount" disabled>
          <span>"Number of slips equals number of transactions on the machine total"</span>
        </label>
        <label class="declitem">
          <input type="checkbox" data-decl="stapled" disabled>
          <span>"Every card slip has its till slip stapled to it"</span>
        </label>
        <label class="declitem">
          <input type="checkbox" data-decl="amounts" disabled>
          <span>"Amount on each card slip matches its till slip"</span>
        </label>
        <label class="declitem">
          <input type="checkbox" data-decl="splits" disabled>
          <span>"Every split payment is initialled by me"</span>
        </label>
        <label class="declitem">
          <input type="checkbox" data-decl="totals" disabled>
          <span>"Machine total equals Palladium card total, or the difference is explained"</span>
        </label>
        <label class="declitem">
          <input type="checkbox" data-decl="filed" disabled>
          <span>"Slips and signed total are punched and filed together for the day"</span>
        </label>
      </div>
    </div>
  </section>
  " "
  <section class="sheet">
    " "
    <div class="sheet-head">
      <div>
        <div class="eyebrow">"Sign-off"</div>
        <h2>"City Deep Retail signature"</h2>
      </div>
    </div>
    " "
    <div class="sheet-body">
      <div class="sign">
        " "
        <div class="sig-img">
          <img src="data:image/png;base64,U0lHTkFUVVJF" alt="Signature of Cindy Deep">
        </div>
        " "
        <div style="display:flex;flex-direction:column;gap:10px">
          " "
          <div>
            <div class="eyebrow">"Signed by"</div>
            <div class="signer-static">"Cindy Deep"</div>
            <div class="msg">"28 Oct, 17:10"</div>
          </div>
          " "
          <div class="msg">"This cash up is locked. Reopen it only to correct a mistake; the signature is removed, the reopen is recorded, and it must be signed again."</div>
          " "
          <div class="actions">
            <button class="btn danger" id="reopen" data-dept="citydeep">"Reopen to correct"</button>
            <span class="msg" id="reopen-msg"></span>
          </div>
          " "
        </div>
      </div>
    </div>
    " "
  </section>
</main>
`;

