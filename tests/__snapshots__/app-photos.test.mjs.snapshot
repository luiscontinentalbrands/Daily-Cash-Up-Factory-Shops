  <details style="margin-top:6px">
    <summary style="cursor:pointer">"Show what the reader saw"</summary>
    <pre style="white-space:pre-wrap;font-size:.78rem;max-height:240px;overflow:auto;background:var(--bg);padding:8px;border-radius:8px">"\`\`\`json {\\"Cash\\": \\"R 1 234,56\\", \\"cashguard\\": 2000, \\"Credit Card\\": \\"1,480.50\\", \\"CBM\\": 10, \\"payfast\\": \\"99,9\\", \\"eft\\": null, \\"shop2shop\\": 5, \\"snapscan\\": \\"abc\\", \\"total\\": 9999, \\"date\\": \\"2026-10-27\\", \\"readable\\": true} \`\`\`"</pre>
  </details>
</div>
`;

