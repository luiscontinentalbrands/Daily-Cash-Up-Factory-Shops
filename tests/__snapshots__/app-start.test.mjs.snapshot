exports[`forced PIN change after the administrator set the PIN 1`] = `
## choose PIN
<main id="main">
  <form class="login sheet" id="pinchange" style="padding:22px" novalidate>
    " "
    <div>
      <div class="eyebrow">"Nina New"</div>
      <h2>"Choose your own PIN"</h2>
    </div>
    " "
    <div class="msg">"Your PIN was set by the administrator. Choose a new 4-digit PIN that only you know."</div>
    " "
    <div class="field">
      <label for="cp1">"New 4-digit PIN"</label>
      <input id="cp1" type="password" inputmode="numeric" maxlength="4" autocomplete="off">
    </div>
    " "
    <div class="field">
      <label for="cp2">"Type the new PIN again"</label>
      <input id="cp2" type="password" inputmode="numeric" maxlength="4" autocomplete="off">
    </div>
    " "
    <button class="btn primary" type="submit" id="cpbtn">"Save new PIN"</button>
    " "
    <button class="linkbtn" type="button" id="cpback">"Not now, go back"</button>
    " "
    <div class="msg" id="cpmsg"></div>
  </form>
</main>
`;

