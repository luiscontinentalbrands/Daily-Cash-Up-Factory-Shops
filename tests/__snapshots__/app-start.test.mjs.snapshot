exports[`code refused or database unreachable 1`] = `
## permission denied
<main id="main">
  <form class="login sheet" id="keyform" style="padding:22px" novalidate>
    " "
    <div>
      <div class="eyebrow">"Set up this device"</div>
      <h2>"Factory Shop Cash Up"</h2>
    </div>
    " "
    <div class="msg">"Open the setup link your manager sent you on this device, or type the shop access code below (a long code of letters and numbers, not your PIN). You only do this once per device. Your PIN comes on the next screen."</div>
    " "
    <div class="field">
      <label for="keyin">"Shop access code"</label>
      <input id="keyin" autocomplete="off" autocapitalize="off" spellcheck="false">
    </div>
    " "
    <button class="btn primary" type="submit" id="keybtn">"Set up this device"</button>
    " "
    <div class="msg err" id="keymsg">"This access code was not accepted. Type the shop access code again, or ask your manager for the setup link. (permission-denied)"</div>
    " "
  </form>
</main>
`;

