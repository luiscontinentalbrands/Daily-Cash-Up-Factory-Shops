exports[`PIN entry: wrong, lockout after 5 tries (shared by all users), right 1`] = `
## pin form
<main id="main">
  <form class="login sheet" id="pinform" style="padding:22px" novalidate>
    " "
    <div>
      <div class="eyebrow">"Wholesale cashier"</div>
      <h2>"Wanda Wholesale"</h2>
    </div>
    " "
    <div class="field">
      <label for="pin">"PIN"</label>
      <input id="pin" type="password" inputmode="numeric" autocomplete="off" maxlength="6" style="font-size:1.4rem;letter-spacing:.4em;text-align:center">
    </div>
    " "
    <button class="btn primary" type="submit">"Enter"</button>
    " "
    <button class="linkbtn" type="button" id="back">"Not you? Go back"</button>
    " "
    <div class="msg" id="pinmsg"></div>
  </form>
</main>
`;

