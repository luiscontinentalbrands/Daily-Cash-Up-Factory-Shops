              <td class="num var-zero" id="v-eft">"R 0,00"</td>
            </tr>
            <tr>
              <td>"Shop2Shop"</td>
              " "
              <td class="inp">
                <input id="wholesale-shop2shop-report" data-m="shop2shop" data-f="report" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value disabled aria-label="Shop2Shop per report">
              </td>
              " "
              <td class="inp">
                <input id="wholesale-shop2shop-deposited" data-m="shop2shop" data-f="deposited" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value disabled aria-label="Shop2Shop deposited">
              </td>
              " "
              <td class="num var-zero" id="v-shop2shop">"R 0,00"</td>
            </tr>
            <tr>
              <td>"SnapScan"</td>
              " "
              <td class="inp">
                <input id="wholesale-snapscan-report" data-m="snapscan" data-f="report" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value disabled aria-label="SnapScan per report">
              </td>
              " "
              <td class="inp">
                <input id="wholesale-snapscan-deposited" data-m="snapscan" data-f="deposited" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value disabled aria-label="SnapScan deposited">
              </td>
              " "
              <td class="num var-zero" id="v-snapscan">"R 0,00"</td>
            </tr>
          </tbody>
          " "
          <tfoot>
            <tr>
              <td>"Total"</td>
              <td class="num" id="t-report">"R 100,00"</td>
              <td class="num" id="t-dep">"R 0,00"</td>
              <td class="num var-neg" id="t-var">"−R 100,00"</td>
            </tr>
            " "
          </tfoot>
          " "
        </table>
      </div>
      " "
      <div class="dmg">
        " "
        <div class="field">
          <label for="wholesale-damaged">"Damaged bank notes & coins (R)"</label>
          <input id="wholesale-damaged" class="num" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value disabled style="text-align:right">
        </div>
        " "
        <div class="field">
          <label for="wholesale-damagedNotes">"Damaged details"</label>
          <input id="wholesale-damagedNotes" value placeholder="e.g. 1 × R100 torn, 3 × R5 coins bent" autocomplete="off" disabled maxlength="300">
        </div>
        " "
      </div>
      " "
      <div class="field">
        <label for="wholesale-notes">"Notes (explain any variance)"</label>
        <textarea id="wholesale-notes" disabled maxlength="1000" placeholder="e.g. R50 short on cash, float counted twice"></textarea>
      </div>
      " "
      <div class="saved" id="saved-wholesale"></div>
      " "
    </div>
    " "
  </section>
  " "
  <section class="sheet">
    " "
    <div class="sheet-head">
      <div>
        <div class="eyebrow">"Sign-off"</div>
        <h2>"Wholesale signature"</h2>
      </div>
    </div>
    " "
    <div class="sheet-body">
      <div class="sign">
        " "
        <div class="sig-img">
          <img src="data:image/png;base64,aW1hZ2UvcG5nfDYwMHgyMDB8b3BzIDJ8cSAt" alt="Signature of Wanda Wholesale">
        </div>
        " "
        <div style="display:flex;flex-direction:column;gap:10px">
          " "
          <div>
            <div class="eyebrow">"Signed by"</div>
            <div class="signer-static">"Wanda Wholesale"</div>
            <div class="msg">"28 Oct, 16:00"</div>
          </div>
          " "
          <div class="msg">"This cash up is locked. Reopen it only to correct a mistake; the signature is removed, the reopen is recorded, and it must be signed again."</div>
          " "
          <div class="actions">
            <button class="btn danger" id="reopen" data-dept="wholesale">"Reopen to correct"</button>
            <span class="msg" id="reopen-msg"></span>
          </div>
          " "
        </div>
      </div>
    </div>
    " "
  </section>
</main>
`;

exports[`signing when the audit trail entry cannot be written 1`] = `
{
  "writes": [
    [
      "set",
      "shops/TestShopKey0123456789abc/cashups/2026-10-28_wholesale",
      "ok"
    ],
    [
      "add",
      "shops/TestShopKey0123456789abc/cashups/2026-10-28_wholesale/history/auto001",
      "permission-denied"
    ]
  ],
  "chip": "Signed off",
  "alert": "The signature was saved, but it could not be written to the audit trail (permission-denied). Tell the administrator."
}
`;
