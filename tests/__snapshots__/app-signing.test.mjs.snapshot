    " "
    <div class="sheet-head">
      <div>
        <div class="eyebrow">"Wholesale department"</div>
        <h2>"Wednesday, 28 October 2026"</h2>
      </div>
      <span class="chip signed">"Signed off"</span>
    </div>
    " "
    <div class="sheet-body">
      " "
      <div class="fields">
        " "
        <div class="field">
          <label>"Date"</label>
          <div class="static">"Wed, 28 Oct 2026"</div>
        </div>
        " "
        <div class="field">
          <label>"Person cashing up"</label>
          <div class="static">"Wanda Wholesale"</div>
        </div>
        " "
        <div class="field">
          <label>"Department"</label>
          <div class="static">"Wholesale"</div>
        </div>
        " "
      </div>
      " "
      <div class="field">
        <label>"Report photos"</label>
        <div data-photos="wholesale">
          <div class="msg">"No photo yet."</div>
        </div>
      </div>
