              <th>"Payment type"</th>
              <th>
                "Per report"
                <small>"Till / Z-report"</small>
              </th>
              <th>
                "Deposited"
                <small>"Actual counted"</small>
              </th>
              <th>
                "Variance"
                <small>"Deposited − report"</small>
              </th>
            </tr>
          </thead>
          " "
          <tbody>
            <tr>
              <td>"Cash"</td>
              " "
              <td class="inp">
                <input id="wholesale-cash-report" data-m="cash" data-f="report" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="1500.00" disabled aria-label="Cash per report">
              </td>
              " "
              <td class="inp">
                <input id="wholesale-cash-deposited" data-m="cash" data-f="deposited" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="1450.00" disabled aria-label="Cash deposited">
              </td>
              " "
              <td class="num var-neg" id="v-cash">"−R 50,00"</td>
            </tr>
            <tr>
              <td>"CashGuard"</td>
              " "
              <td class="inp">
                <input id="wholesale-cashguard-report" data-m="cashguard" data-f="report" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="2000.00" disabled aria-label="CashGuard per report">
              </td>
              " "
              <td class="inp">
                <input id="wholesale-cashguard-deposited" data-m="cashguard" data-f="deposited" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="2000.00" disabled aria-label="CashGuard deposited">
              </td>
              " "
              <td class="num var-zero" id="v-cashguard">"R 0,00"</td>
            </tr>
            <tr>
              <td>"Credit card"</td>
              " "
              <td class="inp">
                <input id="wholesale-card-report" data-m="card" data-f="report" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="3200.50" disabled aria-label="Credit card per report">
