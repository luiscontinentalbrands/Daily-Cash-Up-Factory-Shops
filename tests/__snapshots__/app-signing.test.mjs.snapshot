exports[`a signature that cannot be saved is undone 1`] = `
## message
Not signed. Check the connection and try again.
`;

exports[`a signature that cannot be saved is undone 2`] = `
## still not signed
In progress
`;

exports[`cashier reopens own sheet (tap twice), not after the day is closed 1`] = `
## lock notice
<div class="notice" style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
  <span>
    "This sheet is "
    <b>"signed and locked"</b>
    ", so the figures can't be changed. To correct it, reopen it first: the signature is removed and it must be signed again."
  </span>
  <button class="btn" type="button" id="goreopen">"Reopen to correct"</button>
</div>
`;

