exports[`cashier reopens own sheet (tap twice), not after the day is closed 6`] = `
## day closed
<main id="main">
  <div class="notice" style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
    <span>
      "This sheet is "
