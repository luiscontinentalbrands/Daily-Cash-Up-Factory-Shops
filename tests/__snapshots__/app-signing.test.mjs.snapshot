                <input id="wholesale-payfast-deposited" data-m="payfast" data-f="deposited" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="99.99" disabled aria-label="PayFast card deposited">
              </td>
              " "
              <td class="num var-zero" id="v-payfast">"R 0,00"</td>
            </tr>
            <tr>
              <td>"EFT"</td>
              " "
              <td class="inp">
                <input id="wholesale-eft-report" data-m="eft" data-f="report" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="800.00" disabled aria-label="EFT per report">
              </td>
