              </td>
              " "
              <td class="num var-zero" id="v-eft">"R 0,00"</td>
            </tr>
            <tr>
              <td>"Shop2Shop"</td>
              " "
              <td class="inp">
                <input id="wholesale-shop2shop-report" data-m="shop2shop" data-f="report" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="120.00" disabled aria-label="Shop2Shop per report">
              </td>
              " "
              <td class="inp">
                <input id="wholesale-shop2shop-deposited" data-m="shop2shop" data-f="deposited" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="120.00" disabled aria-label="Shop2Shop deposited">
              </td>
              " "
              <td class="num var-zero" id="v-shop2shop">"R 0,00"</td>
            </tr>
            <tr>
              <td>"SnapScan"</td>
              " "
              <td class="inp">
                <input id="wholesale-snapscan-report" data-m="snapscan" data-f="report" inputmode="decimal" autocomplete="off" autocorrect="off" spellcheck="false" data-lpignore="true" data-form-type="other" placeholder="0.00" value="45.00" disabled aria-label="SnapScan per report">
              </td>
              " "
              <td class="inp">
