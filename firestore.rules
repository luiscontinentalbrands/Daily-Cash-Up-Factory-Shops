rules_version = '2';

// Security rules for the Factory Shop Cash Up (no logins, secret shop access code).
//
// IMPORTANT: replace PASTE_SHOP_ACCESS_CODE below with the real code before publishing.
// Never commit the real code to GitHub: it lives only in the Firebase console.
//
//   - Nothing can be read or written without the secret access code.
//   - Signed sheets are locked. Reopening removes the signature and is recorded.
//   - Once the manager closes the day, a sheet can only be reopened by first reopening the day.
//   - The manager's name must differ from the names of the cashiers who signed.
//   - Signature times come from Google's server clock, not the phone.
//   - The audit trail can only be added to, never changed or deleted.
//   - Nothing can be deleted from the app.

service cloud.firestore {
  match /databases/{database}/documents {

    function okKey(k) { return k == 'PASTE_SHOP_ACCESS_CODE'; }

    match /shops/{k}/cashups/{id} {
      function d() { return request.resource.data; }
      function dept() { return d().dept; }
      function isDeptDoc() { return dept() in ['wholesale', 'retail']; }
      function wasSigned() { return resource != null && resource.data.status == 'signed'; }
      function nowSigned() { return d().status == 'signed'; }
      function otherPath(dp) { return /databases/$(database)/documents/shops/$(k)/cashups/$(d().date + '_' + dp); }
      function otherDoc(dp) { return get(otherPath(dp)).data; }
      function managerSigned() { return exists(otherPath('manager')) && otherDoc('manager').status == 'signed'; }
      function reopening() { return d().reopenedAt == request.time; }
      function signingOk() {
        return d().signedAtServer == request.time
          && d().signedBy is string && d().signedBy.trim().size() >= 3 && d().signedBy.size() <= 80
          && d().signature is string && d().signature.matches('^data:image/png;base64,.*');
      }
      function validShape() {
        return d().date is string
          && d().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && dept() in ['wholesale', 'retail', 'manager']
          && id == d().date + '_' + dept()
          && d().status in ['new', 'draft', 'signed']
          && (resource == null || (resource.data.date == d().date && resource.data.dept == dept()));
      }

      allow read: if okKey(k);
      allow delete: if false;

      allow create, update: if okKey(k) && validShape() && (
        (isDeptDoc() && (
          // editing a draft
          (!wasSigned() && !nowSigned())
          // signing
          || (!wasSigned() && nowSigned() && signingOk())
          // deliberate reopen, only while the day is not closed by the manager
          || (wasSigned() && !nowSigned() && reopening() && !managerSigned())
        ))
        || (dept() == 'manager' && (
          // manager signs off the day: both sheets signed, by someone else
          (!wasSigned() && nowSigned() && signingOk()
            && otherDoc('wholesale').status == 'signed'
            && otherDoc('retail').status == 'signed'
            && d().signedBy.trim().lower() != otherDoc('wholesale').signedBy.trim().lower()
            && d().signedBy.trim().lower() != otherDoc('retail').signedBy.trim().lower())
          // manager reopens the day
          || (wasSigned() && !nowSigned() && reopening())
          || (!wasSigned() && !nowSigned())
        ))
      );

      // Audit trail: append-only
      match /history/{entry} {
        function parent() { return get(/databases/$(database)/documents/shops/$(k)/cashups/$(id)).data; }
        allow read: if okKey(k);
        allow create: if okKey(k)
          && request.resource.data.at == request.time
          && request.resource.data.action in ['signed', 'reopened']
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && (request.resource.data.action == 'signed' ? parent().status == 'signed' : parent().status != 'signed');
        allow update, delete: if false;
      }
    }

    // Photos of the till report, kept with each cash up (can be added, never changed or deleted)
    match /shops/{k}/photos/{pid} {
      function p() { return request.resource.data; }
      allow read: if okKey(k);
      allow create: if okKey(k)
        && p().date is string && p().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && p().dept in ['wholesale', 'retail']
        && p().by is string && p().by.size() <= 80
        && p().at == request.time
        && p().data is string && p().data.size() < 900000
        && p().data.matches('^data:image/jpeg;base64,.*');
      allow update, delete: if false;
    }

    // People who use the app (managed by the administrator inside the app)
    match /shops/{k}/users/{uid} {
      function u() { return request.resource.data; }
      allow read: if okKey(k);
      allow create, update: if okKey(k)
        && u().name is string && u().name.size() >= 3 && u().name.size() <= 60
        && u().role in ['wholesale', 'retail', 'manager', 'admin']
        && u().active is bool
        && u().salt is string && u().pinHash is string && u().pinHash.size() == 64;
      allow delete: if false;
    }

    // Everything else (including the email job's log) is closed to the app.
  }
}
